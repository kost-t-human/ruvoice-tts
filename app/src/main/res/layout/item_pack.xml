<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp">
        <TextView android:id="@+id/title" style="?attr/textAppearanceBodyLarge"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/info" style="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <Button android:id="@+id/delete" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pack_delete" />
</LinearLayout>
