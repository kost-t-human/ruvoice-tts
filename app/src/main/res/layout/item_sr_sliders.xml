<?xml version="1.0" encoding="utf-8"?>
<!-- Темп, высота и громкость экранного чтеца (секция «Для TalkBack», RulesFragment): множители поверх темпа и
     высоты самого TalkBack, вместо ползунков «Голоса». Подпись «×1.00» над ползунком TalkBack не
     слышит — название и значение у самого ползунка (rateSlider). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        style="@style/SectionHint"
        android:text="@string/sr_sliders_hint" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/sr_rate" />
        <TextView
            android:id="@+id/srRateValue"
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.google.android.material.slider.Slider
        android:id="@+id/srRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.5"
        android:valueTo="2.0"
        android:stepSize="0.05"
        app:tickVisible="false"
        app:labelBehavior="floating" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/sr_pitch" />
        <TextView
            android:id="@+id/srPitchValue"
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.google.android.material.slider.Slider
        android:id="@+id/srPitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.5"
        android:valueTo="2.0"
        android:stepSize="0.05"
        app:tickVisible="false"
        app:labelBehavior="floating" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/sr_volume" />
        <TextView
            android:id="@+id/srVolumeValue"
            style="?attr/textAppearanceBodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <com.google.android.material.slider.Slider
        android:id="@+id/srVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.5"
        android:valueTo="2.0"
        android:stepSize="0.05"
        app:tickVisible="false"
        app:labelBehavior="floating" />
</LinearLayout>
