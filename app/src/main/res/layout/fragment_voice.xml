<?xml version="1.0" encoding="utf-8"?>
<!-- У выпадающих полей saveEnabled=false: значение ставит load() из Prefs, а восстановленный
     системой текст запускал бы фильтр AutoCompleteTextView и список сжимался бы до одного пункта. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/voice">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/sample_rate">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/sampleRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_rate_pitch" />
        <TextView
            style="@style/SectionHint"
            android:text="@string/section_rate_pitch_hint" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/quote_rate" />
            <TextView
                android:id="@+id/rateValue"
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×1.00" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="2.0"
            android:stepSize="0.05"
            app:tickVisible="false"
            app:labelBehavior="floating" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/quote_pitch" />
            <TextView
                android:id="@+id/pitchValue"
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×1.00" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="2.0"
            android:stepSize="0.05"
            app:tickVisible="false"
            app:labelBehavior="floating" />

        <TextView
            style="@style/Section"
            android:text="@string/section_quote" />
        <TextView
            style="@style/SectionHint"
            android:text="@string/section_quote_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/quote_voice">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/quoteVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/quote_rate" />
            <TextView
                android:id="@+id/quoteRateValue"
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×1.00" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/quoteRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="2.0"
            android:stepSize="0.05"
            app:tickVisible="false"
            app:labelBehavior="floating" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/quote_pitch" />
            <TextView
                android:id="@+id/quotePitchValue"
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×1.00" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/quotePitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="2.0"
            android:stepSize="0.05"
            app:tickVisible="false"
            app:labelBehavior="floating" />

        <TextView
            style="@style/Section"
            android:text="@string/section_preview" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/preview_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/previewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end">
            <Button
                android:id="@+id/analyze"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/analyze" />
            <Button
                android:id="@+id/preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview"
                app:icon="@drawable/ic_play" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
