<?xml version="1.0" encoding="utf-8"?>
<!-- Диалог «Язык и тема» из меню ⋮ (SettingsActivity.showUiDialog). Названия языков — каждое на своём языке. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            style="@style/Section"
            android:layout_marginTop="8dp"
            android:text="@string/ui_language" />
        <RadioGroup
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/langSystem" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ui_language_system" />
            <RadioButton android:id="@+id/langRu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ui_language_ru" />
            <RadioButton android:id="@+id/langEn" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ui_language_en" />
            <RadioButton android:id="@+id/langZh" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ui_language_zh" />
        </RadioGroup>
        <TextView
            style="@style/Section"
            android:text="@string/ui_theme" />
        <RadioGroup
            android:id="@+id/theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/themeSystem" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ui_theme_system" />
            <RadioButton android:id="@+id/themeLight" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ui_theme_light" />
            <RadioButton android:id="@+id/themeDark" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ui_theme_dark" />
        </RadioGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
