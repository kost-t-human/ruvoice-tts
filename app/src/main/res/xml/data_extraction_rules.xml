<?xml version="1.0" encoding="utf-8"?>
<!-- То же, что backup_rules.xml, для Android 12+: облачный бэкап и перенос между устройствами. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="packs" />
        <!-- Копия ассета для ExecuTorch, пересоздаётся сама -->
        <exclude domain="file" path="backbone.pte" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="packs" />
        <!-- Копия ассета для ExecuTorch, пересоздаётся сама -->
        <exclude domain="file" path="backbone.pte" />
    </device-transfer>
</data-extraction-rules>
